APP_NAME=PlanCatch API
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DB_HOST=
DB_PORT=5432
DB_NAME=plancatch
DB_USER=
DB_PASSWORD=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional web OAuth client for Google sign-in (authorized JavaScript origin required).
# Gmail API recovery mail. Authorize the sender with the gmail.send scope only.
RECOVERY_GMAIL_CLIENT_ID=
RECOVERY_GMAIL_CLIENT_SECRET=
RECOVERY_GMAIL_REFRESH_TOKEN=

# Password recovery mail. Use authenticated SMTP with STARTTLS (587) or implicit TLS (465).
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_IMPLICIT_TLS=false
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
RECOVERY_FROM_EMAIL=

# Kakao OAuth. Register /auth/kakao as the application's return URL.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# Separate Fernet key for encrypted Talk Calendar grants.
KAKAO_CALENDAR_TOKEN_KEY=

GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Separate Fernet key; never reuse JWT_SECRET_KEY or commit an actual key.
GOOGLE_CALENDAR_TOKEN_KEY=
