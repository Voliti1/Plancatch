[Unit]
Description=PlanCatch FastAPI backend
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Plancatch/backend
Environment="PATH=/home/ec2-user/Plancatch/.venv312/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/ec2-user/Plancatch/.venv312/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
